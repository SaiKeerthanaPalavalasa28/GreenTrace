# Copy to backend/.env and fill in. Never commit .env.
APP_ENV=development

# Supabase -> Project Settings -> Database -> Connection string (Session pooler, port 5432).
# Leave unset to use a local SQLite file (backend/greentrace.db) for offline development.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Structured extraction (Google AI Studio key). Without it, bills fail with a clear reason
# and can be reprocessed once it is set.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Free-tier keys allow ~5 requests/minute; set this to stay under your quota.
# GEMINI_REQUESTS_PER_MINUTE=5

# OCR for scanned bills. Only needed if tesseract.exe is not on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Review rules (defaults shown)
# REVIEW_CONFIDENCE_THRESHOLD=0.85
# MAX_BILLING_PERIOD_DAYS=95
# OUTLIER_RATIO=3.0
# EXTRACTION_WORKERS=3

# File storage: "local" (backend/storage) or "s3" (Supabase Storage S3 endpoint, AWS S3, MinIO).
# STORAGE_BACKEND=s3
# S3_BUCKET=greentrace
# S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
# S3_REGION=<supabase project region, e.g. ap-south-1>
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
