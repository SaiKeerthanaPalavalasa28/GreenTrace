# Copy this file to backend/.env and fill it in. .env is git-ignored.
# Real environment variables override values here.

# Outgoing email (needed for organization sign-up). Gmail example:
# turn on 2-Step Verification, then create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# Address of the frontend, used for the "Sign in" link in the email
APP_URL=http://localhost:5173

# Local testing only: print emails in the server log instead of sending
# MAIL_CONSOLE_ONLY=true
